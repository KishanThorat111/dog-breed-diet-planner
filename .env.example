# Flask
SECRET_KEY=your-secret-key-here          # python -c "import secrets; print(secrets.token_hex(32))"
DEBUG=False

# Database — use Postgres in production (Railway sets this automatically)
DATABASE_URL=sqlite:///app.db            # dev default; Railway overrides with postgres://...

# Admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=your-hashed-password # python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('yourpassword'))"

# Redis — optional; required for multi-worker production deployment
# REDIS_URL=redis://localhost:6379/0     # Railway sets this if you add the Redis plugin

# AI Advisor (set the key for whichever provider you activate in admin settings)
# Gemini — free tier, recommended. Get key: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key
#
# OpenAI — paid, very cheap. Get key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-api-key

# Cloudinary — required in production (replaces local static/uploads/)
# Get these from cloudinary.com → Settings → API Keys
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Get these from cloudinary.com → Settings → API Keys
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
